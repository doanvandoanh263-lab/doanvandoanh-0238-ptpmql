@model PagedResult<PermissionRow>
@{
    ViewData["Title"] = "Phân quyền action";
    var role = (Microsoft.AspNetCore.Identity.IdentityRole)ViewBag.Role;
}
<div class="mb-4"><a asp-action="Index" class="text-decoration-none">← Danh sách role</a><h1 class="h2 mt-2">Phân quyền: @role.Name</h1><p class="text-muted">Cho phép hoặc từ chối từng action của các controller.</p></div>
<form asp-action="Permissions" method="get" class="row g-2 mb-3">
    <input type="hidden" name="roleId" value="@role.Id" />
    <div class="col-sm-8 col-md-6"><input class="form-control" type="search" name="searchString" value="@Model.SearchString" placeholder="Tìm controller hoặc action..." /></div>
    <div class="col-auto"><button class="btn btn-outline-primary" type="submit">Tìm kiếm</button></div>
    <div class="col-auto"><button class="btn btn-outline-secondary" type="button" data-grid-clear>Xóa lọc</button></div>
</form>
<form asp-action="SavePermissions" method="post">
    <input type="hidden" name="RoleId" value="@role.Id" />
    <input type="hidden" name="searchString" value="@Model.SearchString" />
    <input type="hidden" name="page" value="@Model.Page" />
    <div class="card shadow-sm"><div class="table-responsive"><table class="table table-hover align-middle mb-0">
        <thead class="table-light"><tr><th>Cho phép</th><th>Controller</th><th>Action</th></tr></thead><tbody>
        @foreach (var item in Model.Items)
        {
            var value = $"{item.Controller}.{item.Action}";
            <tr><td><input class="form-check-input" type="checkbox" name="SelectedActions" value="@value" checked="@item.Granted" disabled="@(role.Name == "Admin")" /></td><td>@item.Controller</td><td>@item.Action</td></tr>
        }
        </tbody>
    </table></div></div>
    @if (role.Name != "Admin") { <button class="btn btn-primary mt-3" type="submit">Lưu phân quyền</button> }
</form>
@if (Model.TotalPages > 1)
{
    <nav class="mt-3" aria-label="Phân trang"><ul class="pagination justify-content-end">
        @for (var index = 1; index <= Model.TotalPages; index++)
        {
            <li class="page-item @(index == Model.Page ? "active" : "")"><a class="page-link" asp-action="Permissions" asp-route-roleId="@role.Id" asp-route-searchString="@Model.SearchString" asp-route-page="@index">@index</a></li>
        }
    </ul></nav>
}
