@model PagedResult<UserRow>
<div class="table-responsive"><table class="table table-hover align-middle">
    <thead class="table-light"><tr><th>Email</th><th>Role</th><th>Email xác thực</th><th></th></tr></thead><tbody>
    @foreach (var user in Model.Items)
    {
        <tr><td>@user.Email</td><td>@(string.IsNullOrEmpty(user.Roles) ? "Chưa gán" : user.Roles)</td><td>@(user.EmailConfirmed ? "Đã xác thực" : "Chưa xác thực")</td><td><a class="btn btn-sm btn-outline-primary" asp-action="Roles" asp-route-id="@user.Id">Gán role</a></td></tr>
    }
    @if (Model.Items.Count == 0) { <tr><td colspan="4" class="text-center text-muted">Không tìm thấy người dùng.</td></tr> }
    </tbody>
</table></div>
<partial name="_Pager" model="Model" />
