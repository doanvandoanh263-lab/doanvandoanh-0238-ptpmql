@model PagedResult<UserRow>
@{
    ViewData["Title"] = "Người dùng";
}
<div class="mb-4"><h1 class="h2 mb-1">Người dùng</h1><p class="text-muted mb-0">Tài khoản được tạo qua Identity; gán role để cấp quyền truy cập.</p></div>
<div class="card shadow-sm"><div class="card-body">
    <form asp-action="Index" method="get" class="row g-2 mb-3" data-grid-search>
        <div class="col-sm-8 col-md-6"><input class="form-control" type="search" name="searchString" value="@Model.SearchString" placeholder="Tìm theo email..." /></div>
        <div class="col-auto"><button class="btn btn-outline-primary" type="submit">Tìm kiếm</button></div>
        <div class="col-auto"><button class="btn btn-outline-secondary" type="button" data-grid-clear>Xóa lọc</button></div>
    </form>
    <div data-grid-results><partial name="_UserList" model="Model" /></div>
</div></div>
