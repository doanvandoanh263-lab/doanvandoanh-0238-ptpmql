@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager
<ul class="navbar-nav">
@if (SignInManager.IsSignedIn(User))
{
    <li class="nav-item"><span class="nav-link text-white">Xin chào, @User.Identity?.Name</span></li>
    <li class="nav-item">
        <form class="d-flex" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
            <button type="submit" class="btn btn-link nav-link text-white text-decoration-none">Đăng xuất</button>
        </form>
    </li>
}
else
{
    <li class="nav-item"><a class="nav-link text-white" asp-area="Identity" asp-page="/Account/Login">Đăng nhập</a></li>
    <li class="nav-item"><a class="nav-link text-white" asp-area="Identity" asp-page="/Account/Register">Đăng ký</a></li>
}
</ul>
