@model PagedResult<Student>
@{
    ViewData["Title"] = "Sinh viên";
}
<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div><h1 class="h2 mb-1">Quản lý sinh viên</h1><p class="text-muted mb-0">Thêm, cập nhật, tìm kiếm và quản lý hồ sơ.</p></div>
    <button class="btn btn-primary" type="button" data-modal-url="@Url.Action("Create")">Thêm sinh viên</button>
</div>
<section class="card shadow-sm">
    <div class="card-body">
        <form class="row g-2 mb-3" action="@Url.Action("Index")" method="get" data-grid-search>
            <div class="col-sm-8 col-md-6"><input class="form-control" type="search" name="searchString" value="@Model.SearchString" placeholder="Tìm mã, họ tên hoặc khoa..." /></div>
            <div class="col-auto"><button class="btn btn-outline-primary" type="submit">Tìm kiếm</button></div>
            <div class="col-auto"><button class="btn btn-outline-secondary" type="button" data-grid-clear>Xóa lọc</button></div>
        </form>
        <div data-grid-results><partial name="_StudentList" model="Model" /></div>
    </div>
</section>
