@page
@model TestMVC2026.Areas.Identity.Pages.Account.ResendEmailConfirmationModel
@{ ViewData["Title"] = "Gửi lại email xác thực"; }
<div class="row justify-content-center py-4">
    <div class="col-sm-10 col-md-7 col-lg-5"><div class="card shadow-sm"><div class="card-body p-4">
        <h1 class="h3 mb-3">Gửi lại email xác thực</h1>
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="mb-3"><label asp-for="Email" class="form-label">Email</label><input asp-for="Email" class="form-control" autocomplete="email" /><span asp-validation-for="Email" class="text-danger"></span></div>
            <button type="submit" class="btn btn-primary w-100">Gửi lại</button>
        </form>
    </div></div></div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
