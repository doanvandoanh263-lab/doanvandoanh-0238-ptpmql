@model DemoMVC.Models.Student

@{
    ViewData["Title"] = "Thêm sinh viên";
}

<section class="page-heading">
    <div>
        <div class="eyebrow"><span class="eyebrow-line"></span> HỒ SƠ SINH VIÊN</div>
        <h1>Thêm sinh viên</h1>
        <p class="page-description">Tạo hồ sơ mới trong hệ thống quản lý đào tạo HUMG.</p>
    </div>
    <a asp-action="Index" class="btn btn-back"><span aria-hidden="true">←</span> Danh sách</a>
</section>

<section class="form-card">
    <form asp-action="Create" method="post">
        <partial name="_StudentForm" model="Model" />
        <div class="form-actions">
            <a asp-action="Index" class="btn btn-back">Hủy</a>
            <button type="submit" class="btn btn-primary btn-create">Lưu hồ sơ sinh viên <span aria-hidden="true">→</span></button>
        </div>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
