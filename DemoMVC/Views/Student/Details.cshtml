@model DemoMVC.Models.Student

@{
    ViewData["Title"] = "Chi tiết sinh viên";
}

<section class="page-heading">
    <div>
        <div class="eyebrow"><span class="eyebrow-line"></span> THÔNG TIN HỒ SƠ</div>
        <h1>Chi tiết sinh viên</h1>
        <p class="page-description">Thông tin đào tạo và cá nhân của sinh viên.</p>
    </div>
    <a asp-action="Index" class="btn btn-back"><span aria-hidden="true">←</span> Danh sách</a>
</section>
<section class="details-card">
    <div class="details-code">@Model.StudentCode</div>
    <dl class="row details-list">
    <dt class="col-sm-3">Mã sinh viên</dt>
    <dd class="col-sm-9">@Model.StudentCode</dd>
    <dt class="col-sm-3">Họ và tên</dt>
    <dd class="col-sm-9">@Model.FullName</dd>
    <dt class="col-sm-3">Năm nhập học</dt>
    <dd class="col-sm-9">@Model.EntryYear</dd>
    <dt class="col-sm-3">Mã hệ đào tạo</dt>
    <dd class="col-sm-9">@Model.TrainingSystemCode</dd>
    <dt class="col-sm-3">Mã ngành</dt>
    <dd class="col-sm-9">@Model.MajorCode</dd>
    <dt class="col-sm-3">Địa chỉ</dt>
    <dd class="col-sm-9">@Model.Address</dd>
    <dt class="col-sm-3">Khoa</dt>
    <dd class="col-sm-9">@Model.Khoa?.Name (@Model.KhoaCode)</dd>
    </dl>
    <a asp-action="Edit" asp-route-id="@Model.StudentCode" class="btn btn-primary btn-create">Chỉnh sửa hồ sơ</a>
</section>
