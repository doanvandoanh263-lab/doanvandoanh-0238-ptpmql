<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - HUMG Student Portal</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/DemoMVC.styles.css" asp-append-version="true" />
</head>
<body>
    <header class="app-header">
        <nav class="navbar navbar-expand-lg app-navbar">
            <div class="container">
                <a class="navbar-brand brand-lockup" asp-controller="Student" asp-action="Index">
                    <span class="brand-mark">H</span>
                    <span class="brand-copy">
                        <strong>HUMG <span>PORTAL</span></strong>
                        <small>QUẢN LÝ SINH VIÊN</small>
                    </span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavigation"
                        aria-controls="mainNavigation" aria-expanded="false" aria-label="Mở menu">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNavigation">
                    <ul class="navbar-nav ms-lg-5 me-auto">
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Student" ? "active" : "")"
                               asp-controller="Student" asp-action="Index">Sinh viên</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Khoa" ? "active" : "")"
                               asp-controller="Khoa" asp-action="Index">Khoa &amp; đơn vị</a>
                        </li>
                    </ul>
                    <div class="header-campus">
                        <span class="campus-indicator"></span>
                        <span>Đại học Mỏ - Địa chất</span>
                    </div>
                </div>
            </div>
        </nav>
    </header>
    <div class="container app-container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <div id="crud-modal" class="modal fade" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-scrollable">
            <div id="crud-modal-content"></div>
        </div>
    </div>

    <footer class="app-footer">
        <div class="container d-flex flex-column flex-sm-row justify-content-between gap-2">
            <span>© 2026 HUMG Student Portal <span class="footer-separator">·</span> Hệ thống quản lý đào tạo</span>
            <span class="footer-status"><span class="campus-indicator"></span> Hệ thống đang hoạt động</span>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
